From: feng <460708473@qq.com>
Subject: [PATCH] net: airoha: preserve TTL on IP-keyed bridge offload

Native L2B is not the only bridge packet type: nft bridge flowtables
also install IPv4/IPv6-keyed rules. Pass explicit bridge metadata to the
Airoha classifier so these entries do not decrement TTL or hop limit.
Preserve them in the software fast path as well. Keep double VLAN and
PPPoE bridge encapsulation on the slow path until tag restoration is
implemented and tested; the imported fast path restores one VLAN only.

This is a local kernel API extension; rebuild all kernel modules together.
---
--- a/include/net/flow_offload.h
+++ b/include/net/flow_offload.h
@@ -693,6 +693,8 @@
 	struct flow_cls_common_offload common;
 	enum flow_cls_command command;
 	bool use_act_stats;
+	/* Local AN7581 bridge offload: preserve L2 TTL semantics. */
+	bool is_bridge;
 	unsigned long cookie;
 	struct flow_rule *rule;
 	struct flow_stats stats;
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -1451,6 +1451,10 @@
 		return err;
 	}
 
+	/* IP-keyed bridge flows must preserve TTL too, not only native L2B. */
+	if (f->is_bridge)
+		hwe.ib1 &= ~AIROHA_FOE_IB1_BIND_TTL;
+
 	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_PORTS)) {
 		struct flow_match_ports ports;
 
--- a/net/netfilter/nf_flow_table_path.c
+++ b/net/netfilter/nf_flow_table_path.c
@@ -242,6 +242,13 @@
 	if (nft_dev_fill_forward_path(&ctx, dst, ct, dir, ha, &stack) >= 0)
 		nft_dev_path_info(&stack, &info, ha, &ft->data);
 
+	if (is_bridging &&
+	    (info.num_encaps > 1 ||
+	     (info.num_encaps == 1 &&
+	      info.encap[0].proto != htons(ETH_P_8021Q) &&
+	      info.encap[0].proto != htons(ETH_P_8021AD))))
+		return -EOPNOTSUPP;
+
 	if (info.outdev)
 		route->tuple[dir].out.ifindex = info.outdev->ifindex;
 	else
--- a/net/netfilter/nf_flow_table_offload.c
+++ b/net/netfilter/nf_flow_table_offload.c
@@ -797,6 +797,18 @@
 }
 EXPORT_SYMBOL_GPL(nf_flow_rule_route_ipv6);
 
+
+int nf_flow_rule_bridge(struct net *net, struct flow_offload *flow,
+                        enum flow_offload_tuple_dir dir,
+                        struct nf_flow_rule *flow_rule)
+{
+	if (nf_flow_rule_route_common(net, flow, dir, flow_rule) < 0)
+		return -1;
+
+	return flow_offload_redirect(net, flow, dir, flow_rule);
+}
+EXPORT_SYMBOL_GPL(nf_flow_rule_bridge);
+
 static struct nf_flow_rule *
 nf_flow_offload_rule_alloc(struct net *net,
 			   const struct flow_offload_work *offload,
@@ -917,6 +929,7 @@
 
 	nf_flow_offload_init(&cls_flow, proto, priority, cmd,
 			     &flow->tuplehash[dir].tuple, &extack);
+	cls_flow.is_bridge = flowtable->type->family == NFPROTO_BRIDGE;
 	if (cmd == FLOW_CLS_REPLACE)
 		cls_flow.rule = flow_rule->rule;
 
--- a/net/netfilter/nf_flow_table_ip.c
+++ b/net/netfilter/nf_flow_table_ip.c
@@ -433,15 +433,17 @@
 	thoff -= ctx->offset;
 
 	iph = ip_hdr(skb);
-	nf_flow_nat_ip(flow, skb, thoff, dir, iph);
-
-	dscp = FIELD_GET(INET_DSCP_MASK, ipv4_get_dsfield(iph));
-	if (tuplehash->tuple.dscp != dscp)
-		ipv4_change_dsfield(iph, INET_ECN_MASK,
-				    FIELD_PREP(INET_DSCP_MASK,
-					       tuplehash->tuple.dscp));
-
-	ip_decrease_ttl(iph);
+	if (flow_table->type->family != NFPROTO_BRIDGE) {
+		nf_flow_nat_ip(flow, skb, thoff, dir, iph);
+
+		dscp = FIELD_GET(INET_DSCP_MASK, ipv4_get_dsfield(iph));
+		if (tuplehash->tuple.dscp != dscp)
+			ipv4_change_dsfield(iph, INET_ECN_MASK,
+					    FIELD_PREP(INET_DSCP_MASK,
+						       tuplehash->tuple.dscp));
+
+		ip_decrease_ttl(iph);
+	}
 	skb_clear_tstamp(skb);
 
 	if (flow_table->flags & NF_FLOWTABLE_COUNTER)
@@ -729,15 +731,17 @@
 	nf_flow_bridge_vlan_push(flow_table, flow, dir, skb);
 
 	ip6h = ipv6_hdr(skb);
-	nf_flow_nat_ipv6(flow, skb, dir, ip6h);
-
-	dscp = FIELD_GET(INET_DSCP_MASK, ipv6_get_dsfield(ip6h));
-	if (tuplehash->tuple.dscp != dscp)
-		ipv6_change_dsfield(ip6h, INET_ECN_MASK,
-				    FIELD_PREP(INET_DSCP_MASK,
-					       tuplehash->tuple.dscp));
-
-	ip6h->hop_limit--;
+	if (flow_table->type->family != NFPROTO_BRIDGE) {
+		nf_flow_nat_ipv6(flow, skb, dir, ip6h);
+
+		dscp = FIELD_GET(INET_DSCP_MASK, ipv6_get_dsfield(ip6h));
+		if (tuplehash->tuple.dscp != dscp)
+			ipv6_change_dsfield(ip6h, INET_ECN_MASK,
+					    FIELD_PREP(INET_DSCP_MASK,
+						       tuplehash->tuple.dscp));
+
+		ip6h->hop_limit--;
+	}
 	skb_clear_tstamp(skb);
 
 	if (flow_table->flags & NF_FLOWTABLE_COUNTER)
--- a/include/net/netfilter/nf_flow_table.h
+++ b/include/net/netfilter/nf_flow_table.h
@@ -365,6 +365,9 @@
 int nf_flow_table_offload_setup(struct nf_flowtable *flowtable,
 				struct net_device *dev,
 				enum flow_block_command cmd);
+int nf_flow_rule_bridge(struct net *net, struct flow_offload *flow,
+			enum flow_offload_tuple_dir dir,
+			struct nf_flow_rule *flow_rule);
 int nf_flow_rule_route_ipv4(struct net *net, struct flow_offload *flow,
 			    enum flow_offload_tuple_dir dir,
 			    struct nf_flow_rule *flow_rule);
--- a/net/netfilter/nf_flow_table_inet.c
+++ b/net/netfilter/nf_flow_table_inet.c
@@ -113,6 +113,7 @@
 {
 	flowtable_bridge = flowtable_inet; flowtable_bridge.family = NFPROTO_BRIDGE;
 	flowtable_bridge.gc = nf_flow_bridge_gc;
+	flowtable_bridge.action = nf_flow_rule_bridge;
 
 	nft_register_flowtable_type(&flowtable_ipv4);
 	nft_register_flowtable_type(&flowtable_ipv6);

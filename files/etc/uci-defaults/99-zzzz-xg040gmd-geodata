#!/bin/sh
# Undo the previous custom Geo update policy on retained-config upgrades.
set -eu
case "$(cat /tmp/sysinfo/board_name)" in
    nokia,xg-040g-md|nokia,xg-040g-md-ubi) ;;
    *) exit 0 ;;
esac
case "$(uci -q get mosdns.config.xg040gmd_geo_defaults || true)" in
    1|2) ;;
    *) exit 0 ;;
esac
uci set mosdns.config.geo_auto_update=0
uci set mosdns.config.geoip_type=geoip-only-cn-private
uci set mosdns.config.geo_update_week_time='*'
uci set mosdns.config.geo_update_day_time=2
if uci -q get passwall.@global_rules[0] >/dev/null; then
    uci set passwall.@global_rules[0].geoip_url='https://github.com/Loyalsoldier/geoip/releases/latest/download/geoip.dat'
    uci commit passwall
fi
uci -q delete mosdns.config.xg040gmd_geo_defaults || true
uci commit mosdns
exit 0

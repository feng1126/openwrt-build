#!/bin/sh
# Keep cloudflared available, but disabled by default in this firmware.
[ -x /etc/init.d/cloudflared ] || exit 0
if uci -q get cloudflared.config >/dev/null; then
    uci set cloudflared.config.enabled='0'
    uci commit cloudflared
fi
/etc/init.d/cloudflared disable
/etc/init.d/cloudflared stop
exit 0

#!/bin/sh
# Apply network defaults only on a fresh installation.
set -eu

case "$(cat /tmp/sysinfo/board_name)" in
	nokia,xg-040g-md-ubi) uplink=pon0; lan_ports="lan1 lan2 lan3 lan4" ;;
	nokia,xg-040g-md) uplink=lan1; lan_ports="lan2 lan3 lan4" ;;
	*) exit 0 ;;
esac

# OpenWrt restores these archives before running uci-defaults. Skip even
# legacy upgrades that do not yet contain our persistent initialization flag.
if [ -f /sysupgrade.tgz ] || [ -f /tmp/sysupgrade.tar ] ||
   [ "$(uci -q get network.globals.xg040gmd_defaults || true)" = 1 ]; then
	exit 0
fi

# PON uses all copper ports as LAN; the stock layout keeps its copper uplink.
bridge=
for section in $(uci show network | sed -n 's/^\(network\.[^.]*\)=device$/\1/p'); do
	if [ "$(uci -q get "$section.name" || true)" = br-lan ]; then
		bridge="$section"
		break
	fi
done
if [ -z "$bridge" ]; then
	bridge=network.br_lan
	uci set "$bridge=device"
	uci set "$bridge.name=br-lan"
fi
uci set "$bridge.type=bridge"
uci -q delete "$bridge.ports" || true
for port in $lan_ports; do
	uci add_list "$bridge.ports=$port"
done

uci set network.lan=interface
uci set network.lan.device=br-lan
uci set network.lan.proto=static
# Keep the default LAN address consistent with default-settings.
uci set network.lan.ipaddr=10.10.10.10
uci set network.lan.netmask=255.255.255.0
uci -q delete network.lan.gateway || true
uci -q delete network.lan.ifname || true

# Remove both naming variants to avoid duplicate WAN clients.
for interface in wan wan6 WAN WAN6; do
	uci -q delete "network.$interface" || true
done
uci set network.WAN=interface
uci set "network.WAN.device=$uplink"
uci set network.WAN.proto=dhcp
uci set network.WAN6=interface
uci set "network.WAN6.device=$uplink"
uci set network.WAN6.proto=dhcpv6
uci set network.WAN6.reqaddress=try
# This device needs an upstream IPv6 address, not a delegated LAN prefix.
uci set network.WAN6.reqprefix=no

wan_zone=
for section in $(uci show firewall | sed -n 's/^\(firewall\.[^.]*\)=zone$/\1/p'); do
	networks="$(uci -q get "$section.network" || true)"
	uci -q delete "$section.network" || true
	for interface in $networks; do
		case "$interface" in
			wan|wan6|WAN|WAN6) ;;
			*) uci add_list "$section.network=$interface" ;;
		esac
	done
	if [ "$(uci -q get "$section.name" || true)" = wan ]; then
		wan_zone="$section"
	fi
done
if [ -z "$wan_zone" ]; then
	wan_zone="firewall.$(uci add firewall zone)"
	uci set "$wan_zone.name=wan"
	uci set "$wan_zone.input=REJECT"
	uci set "$wan_zone.output=ACCEPT"
	uci set "$wan_zone.forward=REJECT"
fi
uci add_list "$wan_zone.network=WAN"
uci add_list "$wan_zone.network=WAN6"
uci set "$wan_zone.masq=1"
uci set "$wan_zone.mtu_fix=1"

forwarding=
for section in $(uci show firewall | sed -n 's/^\(firewall\.[^.]*\)=forwarding$/\1/p'); do
	if [ "$(uci -q get "$section.src" || true)" = lan ] &&
	   [ "$(uci -q get "$section.dest" || true)" = wan ]; then
		forwarding="$section"
		break
	fi
done
if [ -z "$forwarding" ]; then
	forwarding="firewall.$(uci add firewall forwarding)"
	uci set "$forwarding.src=lan"
	uci set "$forwarding.dest=wan"
fi

# Preserve upstream DHCPv6/ICMPv6 rules and existing firewall policies.
uci -q get network.globals >/dev/null || uci set network.globals=globals
uci set network.globals.xg040gmd_defaults=1
uci commit network
uci commit firewall
exit 0

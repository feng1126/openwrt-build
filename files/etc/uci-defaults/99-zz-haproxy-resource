#!/bin/sh
# The package's stock example only serves a health-check on port 60000.
# Keep user-configured HAProxy services.
[ -x /etc/init.d/haproxy ] || exit 0
[ -f /etc/haproxy.cfg ] || exit 0
if cmp -s /etc/haproxy.cfg /rom/etc/haproxy.cfg &&
    grep -q '^# Example configuration file for HAProxy' /etc/haproxy.cfg; then
    /etc/init.d/haproxy disable
    /etc/init.d/haproxy stop
fi
exit 0

CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_lsblk=y

# Default settings, automatic disk mounting and Samba shares
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_autosamba=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-aliyun=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_ddns-scripts-dnspod=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_ddns-scripts-transip=y
CONFIG_PACKAGE_ddns-scripts-utils=y

# IPv6 DHCP client for the lan1 WAN6 interface
CONFIG_PACKAGE_odhcp6c=y

# Enhanced NATMap interface and matching backend
CONFIG_PACKAGE_natmapt=y
CONFIG_PACKAGE_luci-app-natmapt=y
CONFIG_PACKAGE_luci-i18n-natmapt-zh-cn=y
# CONFIG_PACKAGE_natmap is not set
# CONFIG_PACKAGE_luci-app-natmap is not set
# CONFIG_PACKAGE_luci-i18n-natmap-zh-cn is not set
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

# Full Cone NAT support; enable manually in Network > Firewall
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_firewall4=y


CONFIG_KERNEL_DEBUG_FS=y

# PON MAC, EN7572 optical frontend, OMCI/OAM and LuCI management
CONFIG_PACKAGE_kmod-airoha-xpon=y
CONFIG_PACKAGE_kmod-airoha-pon-frontend=y
CONFIG_PACKAGE_kmod-airoha-en7572=y
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_airoha-pond=y
CONFIG_PACKAGE_airoha-pon-debug=y
CONFIG_PACKAGE_luci-app-pon=y
CONFIG_PACKAGE_luci-app-iptv=y
CONFIG_PACKAGE_luci-i18n-pon-zh-cn=y
CONFIG_PACKAGE_luci-i18n-iptv-zh-cn=y

# Reuse compiler results between GitHub Actions runs.
CONFIG_DEVEL=y
CONFIG_CCACHE=y

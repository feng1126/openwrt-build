config AdGuardHome 'AdGuardHome'
	option enabled '1'
	option httpport '3000'
	option redirect 'none'
	option configpath '/mnt/sda1/AdGuardHome/adguardhome.yaml'
	option workdir '/mnt/sda1/AdGuardHome'
	option logfile '/mnt/sda1/AdGuardHome/runtime.log'
	option verbose '0'
	option binpath '/usr/bin/AdGuardHome'
	option upxflag ''
	list upprotect '$binpath'
	list upprotect '$configpath'
	option downloadlinks 'https://static.adguard.com/adguardhome/release/AdGuardHome_linux_${Arch}.tar.gz
#https://static.adguard.com/adguardhome/beta/AdGuardHome_linux_${Arch}.tar.gz
https://github.com/AdguardTeam/AdGuardHome/releases/download/${latest_ver}/AdGuardHome_linux_${Arch}.tar.gz'
	option arch 'arm64'
	option waitonboot '0'
	option ucitracktest '0'
	option gfw_enabled '0'
	option gfw_auto_update '0'
	option gfw_use_backup '1'
	list gfw_domestic_dns '223.5.5.5'
	list gfw_domestic_dns '119.29.29.29'
	list gfw_domestic_dns '114.114.114.114'
	list gfw_foreign_dns 'https://dns.google/dns-query'
	list gfw_foreign_dns 'https://cloudflare-dns.com/dns-query'
	list gfw_download_urls 'https://gcore.jsdelivr.net/gh/gfwlist/gfwlist/gfwlist.txt'
	list gfw_download_urls 'https://raw.githubusercontent.com/gfwlist/gfwlist/master/gfwlist.txt'
	list gfw_download_urls 'https://fastly.jsdelivr.net/gh/gfwlist/gfwlist/gfwlist.txt'

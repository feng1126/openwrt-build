#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=18
USE_PROCD=1

# netifd starts later; latch the configured PON MAC before OAM reads it.
apply_device_mac() {
 local section="$1" name mac current was_up
 config_get name "$section" name
 [ "$name" = "$PON_DEVICE" ] || return 0
 config_get mac "$section" macaddr
 [ -n "$mac" ] || return 0
 current=$(cat "/sys/class/net/$name/address") || return 1
 [ "$current" != "$(echo "$mac" | tr A-F a-f)" ] || return 0
 was_up=0
 ip link show dev "$name" | grep -q '<[^>]*UP[,>]' && was_up=1
 ip link set dev "$name" down || return 1
 ip link set dev "$name" address "$mac" || return 1
 [ "$was_up" = 0 ] || ip link set dev "$name" up
 return 0
}

prepare_device_mac() (
 PON_DEVICE="$1"
 config_load network
 config_foreach apply_device_mac device
)

apply_line() {
	local section="$1"
	local device mode serial registration

	config_get device "$section" device
	config_get mode "$section" mode
	config_get serial "$section" serial_number
	config_get registration "$section" registration_id

	[ -n "$device" ] || {
		echo "xpon section '$section' has no device" >&2
		return 1
	}
	[ -n "$serial" ] || serial=default
	[ -n "$registration" ] || registration=default

	prepare_device_mac "$device" || return 1

	if [ -n "$mode" ]; then
		/usr/sbin/ponctl --device "$device" mode set "$mode" || return 1
	fi
	/usr/sbin/ponctl --device "$device" identity set \
		--serial "$serial" \
		--registration-id "$registration"
}

apply_all_lines() {
	config_load pon
	config_foreach apply_line xpon
}

start_service() {
	apply_all_lines
}

reload_service() {
	apply_all_lines
}

service_triggers() {
	procd_add_reload_trigger pon
}
